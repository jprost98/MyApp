<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Details"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="20dp" />

        <!-- Year -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Year"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/vehicle_detailed_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle Year"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Make -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/vehicle_detailed_make"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle Make"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Model -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Model"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/vehicle_detailed_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle Model"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Submodel / Trim -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submodel / Trim"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/vehicle_detailed_submodel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Engine -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engine"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/vehicle_detailed_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Notes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/vehicle_detailed_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:layout_marginTop="2dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
