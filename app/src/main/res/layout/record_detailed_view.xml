<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record Details"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="20dp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/record_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Date -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/record_detail_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Date"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Vehicle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/record_detail_vehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Vehicle"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Odometer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Odometer Reading"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/record_detail_odometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Odometer Reading"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Notes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:alpha="0.6" />
        <TextView
            android:id="@+id/record_detail_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp" />

        <!-- Documents section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Documents"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_record_doc_btn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textAllCaps="false"
                app:icon="@drawable/ic_add_lt"
                app:iconSize="18dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/record_detail_docs_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <ProgressBar
                android:id="@+id/record_detail_document_loading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="16dp" />

        <!-- Photos section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Photos"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_photo_btn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textAllCaps="false"
                app:icon="@drawable/ic_photo_dark"
                app:iconSize="18dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/record_photos_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/record_detail_photo_loading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
