<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="16dp" />

        <!-- User info row -->
        <LinearLayout
            android:id="@+id/user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:alpha="0.7" />
            </LinearLayout>

            <ImageView
                android:id="@+id/edit_profile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:contentDescription="Edit profile"
                app:srcCompat="@drawable/ic_edit_light"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="16dp" />

        <!-- Level / XP -->
        <LinearLayout
            android:id="@+id/level_xp_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/profile_level"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Level: 0"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView
                    android:id="@+id/profile_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XP: 0"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/current_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:alpha="0.6" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/profile_xp_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:indeterminate="false" />

                <TextView
                    android:id="@+id/nxt_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:alpha="0.6" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="16dp" />

        <!-- Stats -->
        <LinearLayout
            android:id="@+id/user_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ach_earned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Achievements: 0"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/records_added"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Records: 0"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/vehicles_added"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vehicles: 0"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tasks_added"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tasks: 0"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Unused progress bar kept for code compatibility -->
        <ProgressBar
            android:id="@+id/progressBar3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
